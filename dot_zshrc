# Completions (must come before compinit)
FPATH="/opt/homebrew/share/zsh/site-functions:${FPATH}"
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # case-insensitive

# History
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Tools
eval "$(fnm env --use-on-cd --shell zsh)"
eval "$(starship init zsh)"
export EDITOR="code --wait"

# User configuration
## Custom aliases
alias docker=podman
alias gaa="git add *"
alias gc='f() { git commit -m "$1" };f'
alias gca="git commit --amend --no-edit"
alias gp="git push"
alias gpf="git push --force-with-lease"
alias ls="eza --icons --sort=type"
alias ll="eza -la --icons --git --sort=type"
alias lt="eza --tree --level=2 --icons --sort=type"
alias reload="source ~/.zshrc"
alias zshconfig="chezmoi edit ~/.zshrc"

# Plugins
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
## Syntax highlighting must be sourced after everything else except SDKMAN
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
