# Completions (must come before compinit)
FPATH="/opt/homebrew/share/zsh/site-functions:${FPATH}"
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # case-insensitive

# History
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Tools
eval "$(fnm env --use-on-cd --shell zsh)"
eval "$(starship init zsh)"
export EDITOR="code --wait"

# User configuration
## Custom aliases
### Directory listing
alias ls="eza --icons --sort=extension"
alias ll="eza -la --icons --git --sort=extension"
alias lt="eza --tree --level=2 --icons --sort=extension"

### Navigating
alias dev="cd ~/Workspace"

### Git
alias gaa="git add -A"
gc() {
    git commit -m "$*"
}
alias gca="git commit --amend --no-edit"
alias gp="git push"
alias gpf="git push --force-with-lease"
gsw() {
  local branch
  branch=$(git branch --sort=-committerdate --format='%(refname:short)' \
    | fzf --height=40% --reverse --prompt='branch> ') || return
  git switch "$branch"
}
gswa() {
  local branch
  branch=$(git branch --all --sort=-committerdate --format='%(refname:short)' \
    | sed 's|^origin/||' | grep -v '^HEAD' | awk '!seen[$0]++' \
    | fzf --height=40% --reverse) || return
  git switch "$branch"
}
remove-branches() {
    git branch | grep -v "develop" | grep -v "main" | xargs git branch -D
}

### Docker
alias docker=podman

### Sdkman
sdklist () {
    for c in ~/.sdkman/candidates/*/; do
        name=$(basename "$c")
        current=$(basename "$(readlink "$c/current")" 2>/dev/null)
        printf "\033[1m%s\033[0m  \033[2m%s\033[0m\n" "$name" "${c%/}"
        for v in "$c"*/; do
            ver=$(basename "$v")
            [ "$ver" = "current" ] && continue
            if [ "$ver" = "$current" ]; then
                printf "  \033[32m* %-20s\033[0m \033[2m%s\033[0m\n" "$ver (current)" "${v%/}"
            else
                printf "    %-20s \033[2m%s\033[0m\n" "$ver" "${v%/}"
            fi
        done
    done
}

### Media management
alias wav2mp3='for f in *.wav; do ffmpeg -i "$f" -codec:a libmp3lame -q:a 2 "${f%.wav}.mp3"; done'

### Shell
alias dump_brewfile='f() { brew bundle dump --force --file="$(chezmoi source-path)/Brewfile" };f'
alias reload="clear && source ~/.zshrc"
alias zshconfig="chezmoi edit ~/.zshrc"

# Plugins
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
## Syntax highlighting must be sourced after everything else except SDKMAN
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
